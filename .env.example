# ---------------------------------------------------------------------------
# HustleCraft configuration
# Copy to `.env` — every value is optional. With no keys at all the server
# still runs and falls back to its built-in offline generator.
# ---------------------------------------------------------------------------

# --- HTTP server -----------------------------------------------------------
HC_HOST=0.0.0.0
HC_PORT=8000
HC_ACCESS_LOG=1

# --- Groq cloud (open-weight models: Gemma 2 / Llama 3) --------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODEL=gemma2-9b-it
GROQ_URL=https://api.groq.com/openai/v1/chat/completions

# --- Local Ollama proxy (WSL gateway host) ---------------------------------
# Auto-detects the WSL gateway; 172.22.224.1 is the classic WSL2 NAT host.
OLLAMA_URL=http://172.22.224.1:11434
OLLAMA_MODEL=gemma2:9b

# --- Misc ------------------------------------------------------------------
# Force the advertised LAN/WSL gateway IP (otherwise auto-detected).
HC_GATEWAY_IP=
# Upstream model timeout in seconds.
HC_TIMEOUT=60
# Delay between offline fallback chunks in ms (typewriter feel).
HC_OFFLINE_MS=11
